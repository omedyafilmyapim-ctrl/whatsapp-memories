# Environment variables for WhatsApp Memories app
# Copy this file to .env.local and fill in your values

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WhatsApp Memories

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_memories?schema=public"

# Authentication (Clerk or NextAuth)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# External Services (Supabase, Resend, etc.)
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=